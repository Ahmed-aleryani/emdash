{
	"compilerOptions": {
		"target": "ES2024",
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"declaration": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
